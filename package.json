{
  "name": "plainly",
  "version": "2.0.0",
  "description": "Plainly: an accessible, privacy-first GenAI assistant that explains, compares and answers questions about legal documents in plain language.",
  "type": "module",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "next dev --webpack",
    "dev:server": "tsx watch src/server/index.ts",
    "dev:web": "next dev --webpack",
    "build": "npm run build:web && npm run build:server",
    "build:web": "next build --webpack",
    "build:server": "tsc -p tsconfig.server.json",
    "start": "next start",
    "typecheck": "next typegen && tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.next.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:smoke": "node scripts/smoke.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "*",
    "@tailwindcss/postcss": "^4.3.3",
    "clsx": "*",
    "compression": "^1.8.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "fflate": "^0.8.3",
    "helmet": "^8.3.0",
    "lucide-react": "*",
    "next": "^16.3.6",
    "radix-ui": "*",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "unpdf": "^1.8.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@tailwindcss/vite": "*",
    "@testing-library/jest-dom": "*",
    "@testing-library/react": "*",
    "@testing-library/user-event": "*",
    "@types/compression": "^1.8.1",
    "@types/express": "*",
    "@types/node": "^24.13.6",
    "@types/react": "*",
    "@types/react-dom": "*",
    "@vitejs/plugin-react": "*",
    "@vitest/coverage-v8": "*",
    "axe-core": "*",
    "concurrently": "*",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "*",
    "eslint-plugin-react-hooks": "*",
    "globals": "*",
    "jsdom": "*",
    "tailwindcss": "*",
    "tsx": "*",
    "typescript": "~6.0.3",
    "typescript-eslint": "*",
    "vite": "*",
    "vitest": "*"
  }
}
