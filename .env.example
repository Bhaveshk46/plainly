# Copy to .env and fill in. Never commit .env.
# Without a key Plainly analyses text on-device (rule-based).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

PORT=3000
# Set to 1 when running behind a reverse proxy / load balancer (e.g. Cloud Run)
# so rate limiting sees real client IPs.
# TRUST_PROXY=1

# Optional tuning
# MAX_DOC_CHARS=150000
# MAX_UPLOAD_BYTES=8388608
# RATE_LIMIT_AI=20
# RATE_LIMIT_GENERAL=120
# GEMINI_TIMEOUT_MS=60000
# SHARES_ENABLED=true
# SHARE_DB_PATH=./data/shares.sqlite
# RATE_LIMIT_SHARES=20

# Public deployment origin for canonical URLs and the sitemap.
# SITE_URL=https://your-project.vercel.app
# Vercel disables SQLite shares and caps uploads at 3 MB automatically.
