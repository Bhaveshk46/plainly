{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2023"],
    "types": ["node"],
    "rootDir": "src",
    "outDir": "dist",
    "sourceMap": true,
    "noEmitOnError": true
  },
  "include": ["src/server/**/*.ts", "src/shared/**/*.ts"],
  // Browser-side encryption (WebCrypto types need the DOM lib); the server never imports it.
  "exclude": ["src/shared/crypto.ts"]
}
